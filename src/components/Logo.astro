---
/** Bildmarke: stilisierter Fahrradkoffer mit Laufrad – auch als favicon.svg verwendet. */
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <rect width="40" height="40" rx="11" fill="#244C3A"></rect>
  <rect x="8" y="11" width="24" height="16" rx="4" fill="none" stroke="#F7F7F2" stroke-width="2.2"></rect>
  <circle cx="20" cy="19" r="4.6" fill="none" stroke="#F7F7F2" stroke-width="1.8"></circle>
  <circle cx="12.5" cy="30.5" r="1.9" fill="#F7F7F2"></circle>
  <circle cx="17.5" cy="30.5" r="1.9" fill="#F7F7F2"></circle>
</svg>

<style>
  .logo {
    flex: none;
  }
</style>
