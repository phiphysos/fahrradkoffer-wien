---
import Legal from '../layouts/Legal.astro';
import { business, contact, legal } from '../../site.config';

const missing = (v: string, label: string) => v || `[${label} in site.config.ts eintragen]`;
---

<Legal title="Impressum" path="impressum/">
  <h2>Offenlegung gemäß § 25 MedienG und Angaben gemäß § 5 ECG</h2>
  <p>
    <strong>{business.name}</strong><br />
    <span class:list={{ todo: !legal.ownerName }}>{missing(legal.ownerName, 'Vor- und Nachname')}</span><br />
    <span class:list={{ todo: !legal.street }}>{missing(legal.street, 'Straße und Hausnummer')}</span><br />
    <span class:list={{ todo: !legal.postalCity }}>{missing(legal.postalCity, 'PLZ und Ort')}</span><br />
    Österreich
  </p>
  <p>E-Mail: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>

  <h2>Tätigkeit</h2>
  <p>Privater Verleih von Fahrradkoffern in Wien.</p>

  <h2>Grundlegende Richtung</h2>
  <p>Information über das Angebot zur Vermietung von Fahrradkoffern in Wien.</p>

  <h2>Haftung für Links</h2>
  <p>
    Diese Website enthält Links zu externen Websites (z. B. Google Maps). Für deren Inhalte sind ausschließlich die
    jeweiligen Betreiber verantwortlich.
  </p>
</Legal>
