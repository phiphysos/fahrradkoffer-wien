---
import { Mail, Send, Copy, Check, ArrowUpRight } from '@lucide/astro';
import { contact, product } from '../../site.config';

const caseOptions = Array.from({ length: Math.max(1, product.units) }, (_, i) => i + 1);
---

<section id="anfrage" class="section inquiry" aria-labelledby="inquiry-title">
  <div class="container inquiry__grid">
    <div class="inquiry__intro">
      <p class="eyebrow" data-reveal>Anfrage</p>
      <h2 id="inquiry-title" class="h2" data-reveal style="--reveal-delay: 60">Bereit für deine nächste Radreise?</h2>
      <p class="lead" data-reveal style="--reveal-delay: 120">
        Schick uns deinen Wunschzeitraum. Wir melden uns persönlich mit der Verfügbarkeit und einem Vorschlag für die
        Übergabe.
      </p>

      <div class="howto" data-reveal style="--reveal-delay: 180">
        <Mail aria-hidden="true" stroke-width={1.6} />
        <div>
          <h3 class="howto__title">So funktioniert die Anfrage</h3>
          <p>
            Beim Klick auf <strong>„Anfrage-E-Mail erstellen“</strong> öffnet sich dein E-Mail-Programm mit einer fertig
            ausgefüllten Nachricht. Erst wenn du sie dort absendest, erreicht uns deine Anfrage. Das ist noch keine
            Reservierung – die Verfügbarkeit bestätigen wir dir per E-Mail.
          </p>
        </div>
      </div>

      <p class="fallback" data-reveal style="--reveal-delay: 220">
        Lieber direkt schreiben?
        <a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>

    <div class="form-card" data-reveal style="--reveal-delay: 120">
      <form
        id="inquiry-form"
        class="form"
        action={`mailto:${contact.email}`}
        method="post"
        enctype="text/plain"
        novalidate
        data-email={contact.email}
        data-product={product.name}
      >
        <div class="field">
          <label for="f-name">Name</label>
          <input id="f-name" name="Name" type="text" autocomplete="name" required aria-describedby="f-name-error" />
          <p class="field__error" id="f-name-error" hidden></p>
        </div>

        <div class="field">
          <label for="f-email">E-Mail</label>
          <input
            id="f-email"
            name="E-Mail"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            aria-describedby="f-email-error"
          />
          <p class="field__error" id="f-email-error" hidden></p>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-start">Mietbeginn</label>
            <input id="f-start" name="Mietbeginn" type="date" required aria-describedby="f-start-error" />
            <p class="field__error" id="f-start-error" hidden></p>
          </div>
          <div class="field">
            <label for="f-end">Mietende</label>
            <input id="f-end" name="Mietende" type="date" required aria-describedby="f-end-error" />
            <p class="field__error" id="f-end-error" hidden></p>
          </div>
        </div>

        <fieldset class="field">
          <legend>Anzahl der Koffer</legend>
          <div class="segmented">
            {
              caseOptions.map((n) => (
                <label class="segmented__option">
                  <input type="radio" name="Koffer" value={n} checked={n === 1} />
                  <span>{n} Koffer</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="f-message">Nachricht <span class="optional">optional</span></label>
          <textarea
            id="f-message"
            name="Nachricht"
            rows="4"
            maxlength="1200"
            placeholder="z. B. Reiseziel, Radtyp oder Fragen zur Passform"></textarea>
        </div>

        <button class="btn btn--primary btn--block form__submit" type="submit">
          Anfrage-E-Mail erstellen <Send aria-hidden="true" />
        </button>
        <p class="form__hint">Öffnet dein E-Mail-Programm. Es wird nichts automatisch gesendet oder reserviert.</p>
      </form>

      <div class="done" id="inquiry-done" hidden tabindex="-1">
        <span class="done__icon"><Check aria-hidden="true" /></span>
        <h3 class="done__title">Fast geschafft!</h3>
        <p>
          Dein E-Mail-Programm sollte sich jetzt mit der vorbereiteten Nachricht geöffnet haben. Bitte sende sie dort ab –
          danach melden wir uns bei dir.
        </p>
        <div class="done__actions">
          <a class="btn btn--primary" id="inquiry-reopen" href={`mailto:${contact.email}`}>
            E-Mail erneut öffnen <ArrowUpRight aria-hidden="true" />
          </a>
          <button class="btn btn--ghost" type="button" id="inquiry-copy">
            <Copy aria-hidden="true" /> <span data-copy-label aria-live="polite">Text kopieren</span>
          </button>
        </div>
        <p class="done__small">
          Kein E-Mail-Programm eingerichtet? Kopiere den Text und schick ihn an
          <a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a>.
        </p>
        <button class="done__back text-link" type="button" id="inquiry-back">Angaben bearbeiten</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initInquiry } from '../scripts/inquiry';
  initInquiry();
</script>

<style>
  .inquiry__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  @media (min-width: 1000px) {
    .inquiry__grid {
      grid-template-columns: 1fr 1.05fr;
      align-items: start;
    }
    .inquiry__intro {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .inquiry__intro .lead {
    margin-top: 1.5rem;
  }

  .howto {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius);
    background: var(--sage);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .howto > :global(svg) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent);
    margin-top: 0.1rem;
  }

  .howto__title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }

  .howto strong {
    color: var(--ink);
    font-weight: 600;
  }

  .fallback {
    margin-top: 1.5rem;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .fallback .text-link {
    color: var(--accent);
  }

  /* Formular */
  .form-card {
    padding: clamp(1.25rem, 4vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .form {
    display: grid;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
    border: 0;
    padding: 0;
  }

  .field-row {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 480px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }

  label,
  legend {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0;
  }

  legend {
    margin-bottom: 0.45rem;
  }

  .optional {
    margin-left: 0.35rem;
    font-weight: 400;
    color: var(--ink-soft);
  }

  input[type='text'],
  input[type='email'],
  input[type='date'],
  textarea {
    width: 100%;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid rgba(23, 26, 23, 0.2);
    border-radius: 0.875rem;
    background: var(--bg);
    font-size: 1rem; /* verhindert Zoom auf iOS */
    line-height: 1.4;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
    -webkit-appearance: none;
    appearance: none;
  }

  input[type='date'] {
    display: block;
    text-align: left;
  }

  input[type='date']::-webkit-date-and-time-value {
    text-align: left;
  }

  textarea {
    resize: vertical;
    min-height: 7.5rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: #7a817c;
  }

  input:hover,
  textarea:hover {
    border-color: rgba(23, 26, 23, 0.4);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(36, 76, 58, 0.18);
  }

  [aria-invalid='true'] {
    border-color: var(--danger) !important;
    box-shadow: 0 0 0 3px rgba(161, 50, 31, 0.12) !important;
  }

  .field__error {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--danger);
  }

  .segmented {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 0.35rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: var(--sage);
  }

  .segmented__option {
    position: relative;
    cursor: pointer;
  }

  .segmented__option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .segmented__option span {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .segmented__option input:checked + span {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 3px rgba(23, 26, 23, 0.12);
  }

  .segmented__option input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .form__submit {
    margin-top: 0.5rem;
    min-height: 3.5rem;
  }

  .form__hint {
    margin-top: -0.35rem;
    font-size: 0.8125rem;
    text-align: center;
    color: var(--ink-soft);
  }

  /* Bestätigung */
  .done {
    display: grid;
    justify-items: start;
    gap: 1rem;
    outline: none;
  }

  .done__icon {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .done__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .done__title {
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
  }

  .done p {
    color: var(--ink-soft);
  }

  .done__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 479px) {
    .done__actions .btn {
      flex: 1 1 100%;
    }
  }

  .done__small {
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .done__back {
    border: 0;
    background: none;
    padding: 0.5rem 0;
    min-height: 44px;
    color: var(--accent);
  }
</style>
